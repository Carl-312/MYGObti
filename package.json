{
  "name": "mygobti-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "preview:prod": "node scripts/preview-prod.mjs",
    "backup:snapshot": "bash scripts/backup-snapshot.sh",
    "build": "npm run build:web && npm run typecheck:api && npm run typecheck:core",
    "build:web": "npm run build --workspace apps/web",
    "preview:web": "npm run preview --workspace apps/web --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:web": "npm run typecheck --workspace apps/web",
    "typecheck:api": "npm run typecheck --workspace apps/api",
    "typecheck:core": "npm run typecheck --workspace @mygobti/quiz-core"
  }
}
